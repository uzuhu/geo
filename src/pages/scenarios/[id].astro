---
import Base from '../../layouts/Base.astro';
import QaList from '../../components/QaList.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getPublishedGuides, toCard, buildQuestionGroups, withBase } from '../../lib/guides';
import { SCENARIOS, getScenario, scenarioHref, type ScenarioId } from '../../lib/scenarios';

export function getStaticPaths() {
  return SCENARIOS.map((s) => ({ params: { id: s.id } }));
}

const id = Astro.params.id as ScenarioId;
const scenario = getScenario(id);
const guides = await getPublishedGuides();
const groups = buildQuestionGroups(guides, scenario.topics);
const cards = guides
  .filter((g) => scenario.topics.includes(g.data.topic as TopicId))
  .map(toCard);
const allHref = withBase('/scenarios/');
---

<Base title={scenario.question} description={`${scenario.blurb}。按任务找 GEO 做法，相关问题点开即看解答。`}>
  <main id="main" class="page page--list">
    <header class="list-hero">
      <p class="kicker">{scenario.label}</p>
      <h1>{scenario.question}</h1>
      <p>{scenario.blurb}</p>
    </header>

    <nav class="topic-pills" aria-label="任务">
      <a href={allHref}>全部</a>
      {
        SCENARIOS.map((s) => (
          <a class:list={[s.id === id && 'is-active']} href={scenarioHref(s.id)}>
            {s.label}
          </a>
        ))
      }
    </nav>

    {
      groups.length > 0 && (
        <section aria-label="相关问题与解答">
          <header class="section-head">
            <h2>相关问题，点开即看解答</h2>
            <p>直接在这页看答案；想深入就看完整文章。</p>
          </header>
          <QaList groups={groups} />
        </section>
      )
    }

    {
      cards.length > 0 && (
        <section aria-label="相关文章">
          <header class="section-head">
            <h2>相关文章</h2>
          </header>
          <div class="guide-grid">
            {cards.map((card) => (
              <GuideCard
                href={card.href}
                title={card.title}
                description={card.description}
                kicker={card.kicker}
              />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Base>
