---
import Base from '../../layouts/Base.astro';
import { SCENARIOS, scenarioHref } from '../../lib/scenarios';
import { withBase } from '../../lib/guides';

const home = withBase('/');
---

<Base
  title="按任务找 GEO 做法"
  description="按你正在做的事挑：被 AI 引用、配好技术地基、看效果、讲清楚 GEO、照着改页面。任务导向，而不是目录树。"
>
  <main id="main" class="page page--list">
    <header class="list-hero">
      <p class="kicker">任务导向</p>
      <h1>你正在做的事，对应这些做法</h1>
      <p>不按目录翻，按你的任务挑。</p>
    </header>

    <div class="intent-grid">
      {
        SCENARIOS.map((s) => (
          <a class="intent-card" href={scenarioHref(s.id)}>
            <span class="intent-card__label">{s.label}</span>
            <strong>{s.question}</strong>
            <span>{s.blurb}</span>
          </a>
        ))
      }
    </div>

    <p class="q-foot">
      <span>想系统学一遍？</span>
      <a href={withBase('/guides/')}>浏览全部文章 →</a>
    </p>
  </main>
</Base>
