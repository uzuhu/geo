---
import Base from '../layouts/Base.astro';
import { getPublishedGuides, guideHref, faqId, withBase } from '../lib/guides';
import { TOPICS, getTopic } from '../lib/topics';

const guides = await getPublishedGuides();

const questionGroups = TOPICS.map((topic) => {
  const items = guides
    .filter((g) => g.data.topic === topic.id)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .flatMap((g) =>
      (g.data.faq ?? []).map((faq) => ({
        question: faq.question,
        href: `${guideHref(g.id)}#${faqId(faq.question)}`,
        guideTitle: g.data.title,
      }))
    );
  return { id: topic.id, label: topic.label, question: topic.question, items };
}).filter((g) => g.items.length > 0);

const totalQuestions = questionGroups.reduce((n, g) => n + g.items.length, 0);
const allHref = withBase('/guides/');
---

<Base
  title="GEO 指南"
  description="按真实问题找 GEO 答案：入门、对照 SEO、内容策略、效果度量与技术配置。点一下直达解答。"
>
  <main id="main" class="page page--home">
    <section class="hero">
      <p class="kicker">生成式引擎优化 · GEO</p>
      <h1>你的问题，这里都有答案</h1>
      <p class="hero__lead">
        按真实问题分类，点一下直达解答。一时找不到，就直接搜。
      </p>

      <form class="q-filter" data-q-filter-form>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input
          type="search"
          data-q-filter
          placeholder="搜你的问题，例如：关键词怎么放、怎么衡量效果"
          aria-label="筛选问题"
          autocomplete="off"
        />
        <kbd>Ctrl K</kbd>
      </form>
    </section>

    <p class="q-count">共 {totalQuestions} 个高频问题，按主题归好类：</p>

    <div class="q-index">
      {
        questionGroups.map((group) => (
          <section class="q-group" data-q-group aria-labelledby={`qg-${group.id}`}>
            <header class="q-group__head">
              <span class="q-group__badge">{group.label}</span>
              <h2 id={`qg-${group.id}`}>{group.question}</h2>
              <span class="q-group__count">{group.items.length} 个问题</span>
            </header>
            <ul class="q-list">
              {group.items.map((item) => (
                <li
                  class="q-item"
                  data-q-item
                  data-q-text={`${item.question} ${group.label} ${item.guideTitle}`}
                >
                  <a href={item.href}>
                    <span class="q-item__q" aria-hidden="true">Q</span>
                    <span class="q-item__text">{item.question}</span>
                    <span class="q-item__from">{item.guideTitle}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="q-empty" data-q-empty hidden>没有匹配的问题。换个词试试，或浏览全部文章。</p>

    <p class="q-foot">
      <span>想按主题系统学一遍？</span>
      <a href={allHref}>浏览全部 {guides.length} 篇文章 →</a>
    </p>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-q-filter-form]');
  const filter = document.querySelector<HTMLInputElement>('[data-q-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-q-group]');
  const empty = document.querySelector<HTMLElement>('[data-q-empty]');

  form?.addEventListener('submit', (e) => e.preventDefault());

  function apply() {
    const q = (filter?.value ?? '').trim().toLowerCase();
    let visibleTotal = 0;
    groups.forEach((group) => {
      const items = group.querySelectorAll<HTMLElement>('[data-q-item]');
      let groupVisible = 0;
      items.forEach((item) => {
        const text = item.getAttribute('data-q-text') ?? '';
        const match = !q || text.toLowerCase().includes(q);
        item.hidden = !match;
        if (match) groupVisible++;
      });
      group.hidden = groupVisible === 0;
      visibleTotal += groupVisible;
    });
    if (empty) empty.hidden = visibleTotal !== 0;
  }

  filter?.addEventListener('input', apply);
</script>
