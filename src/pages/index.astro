---
import Base from '../layouts/Base.astro';
import QaList from '../components/QaList.astro';
import { getPublishedGuides, buildQuestionGroups, withBase } from '../lib/guides';
import { SCENARIOS, scenarioHref } from '../lib/scenarios';

const guides = await getPublishedGuides();
const groups = buildQuestionGroups(guides);
const totalQuestions = groups.reduce((n, g) => n + g.items.length, 0);
const allHref = withBase('/guides/');
---

<Base
  title="GEO 指南"
  description="按你正在做的事挑 GEO 做法：被 AI 引用、配好技术地基、看效果、讲清楚、照着改。相关问题点开即看解答。"
>
  <main id="main" class="page page--home">
    <section class="hero">
      <p class="kicker">生成式引擎优化 · GEO</p>
      <h1>你的问题，这里都有答案</h1>
      <p class="hero__lead">
        带着你的任务进来，或直接搜问题。答案点开就在当下。
      </p>

      <form class="q-filter" data-q-filter-form>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input
          type="search"
          data-q-filter
          placeholder="搜你的问题，例如：关键词怎么放、怎么衡量效果"
          aria-label="筛选问题"
          autocomplete="off"
        />
        <kbd>Ctrl K</kbd>
      </form>
    </section>

    <section class="scenarios" aria-labelledby="sc-heading">
      <header class="section-head">
        <h2 id="sc-heading">按你正在做的事挑</h2>
        <p>不是按目录分类，而是按你真实的任务。</p>
      </header>
      <div class="intent-grid">
        {
          SCENARIOS.map((s) => (
            <a class="intent-card" href={scenarioHref(s.id)}>
              <span class="intent-card__label">{s.label}</span>
              <strong>{s.question}</strong>
              <span>{s.blurb}</span>
            </a>
          ))
        }
      </div>
    </section>

    <p class="q-count">也或者直接看高频问题（共 {totalQuestions} 个，点开即看解答）：</p>

    <div class="q-index">
      <QaList groups={groups} />
    </div>

    <p class="q-empty" data-q-empty hidden>没有匹配的问题。换个词试试，或浏览全部文章。</p>

    <p class="q-foot">
      <span>想按主题系统学一遍？</span>
      <a href={allHref}>浏览全部 {guides.length} 篇文章 →</a>
    </p>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-q-filter-form]');
  const filter = document.querySelector<HTMLInputElement>('[data-q-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-q-group]');
  const empty = document.querySelector<HTMLElement>('[data-q-empty]');

  form?.addEventListener('submit', (e) => e.preventDefault());

  function apply() {
    const q = (filter?.value ?? '').trim().toLowerCase();
    let visibleTotal = 0;
    groups.forEach((group) => {
      const items = group.querySelectorAll<HTMLElement>('[data-q-item]');
      let groupVisible = 0;
      items.forEach((item) => {
        const text = item.getAttribute('data-q-text') ?? '';
        const match = !q || text.toLowerCase().includes(q);
        item.hidden = !match;
        if (match) groupVisible++;
      });
      group.hidden = groupVisible === 0;
      visibleTotal += groupVisible;
    });
    if (empty) empty.hidden = visibleTotal !== 0;
  }

  filter?.addEventListener('input', apply);
</script>
