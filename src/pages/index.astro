---
import Base from '../layouts/Base.astro';
import { getWikiEntries, groupByStep, entryHref, wikiIndexHref } from '../lib/wiki';

const entries = await getWikiEntries();
const groups = groupByStep(entries);
---

<Base
  title="GEO 指南"
  description={`做 GEO，就这 ${groups.length} 步：每一步列出你会遇到的问题，一问一词条，点开即看完整答案，并附可用工具。`}
>
  <main id="main" class="page page--home">
    <section class="hero">
      <p class="kicker">生成式引擎优化 · GEO</p>
      <h1>做 GEO，就这 {groups.length} 步</h1>
      <p class="hero__lead">
        每一步：你会遇到什么问题、怎么解决、用什么工具。一问一词条，点开即看完整答案。
      </p>
      <p class="hero__sub">
        <a href={wikiIndexHref()}>直接浏览全部 {entries.length} 个词条 →</a>
      </p>
    </section>

    <ol class="flow">
      {
        groups.map(({ step, entries }, i) => (
          <li class="flow-step">
            <details class="flow-step__panel">
              <summary class="flow-step__head">
                <span class="flow-step__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flow-step__titles">
                  <strong class="flow-step__title">{step.title}</strong>
                  <span class="flow-step__goal">{step.goal}</span>
                </span>
                <span class="flow-step__meta">
                  <span>{entries.length} 个词条</span>
                  {step.tools.length > 0 && <span>{step.tools.length} 个工具</span>}
                  <svg
                    class="flow-step__chevron"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="flow-step__body">
                <p class="flow-step__when">你在这一步：{step.when}</p>

                <section class="flow-sec" aria-label="这一步的问题与解答">
                  <h2>你会遇到的问题（点开看完整答案）</h2>
                  <ul class="q-list">
                    {entries.map((entry) => (
                      <li class="q-item">
                        <a class="q-entry" href={entryHref(entry.id)}>
                          <span class="q-entry__q" aria-hidden="true">Q</span>
                          <span class="q-entry__body">
                            <strong class="q-entry__title">{entry.data.title}</strong>
                            <span class="q-entry__answer">{entry.data.answer}</span>
                          </span>
                          <svg
                            class="q-entry__chevron"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d="M9 6l6 6-6 6"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>

                {step.tools.length > 0 && (
                  <section class="flow-sec" aria-label="这一步可用的工具">
                    <h2>这一步的工具</h2>
                    <ul class="tool-list">
                      {step.tools.map((tool) => (
                        <li class="tool-card">
                          <a
                            class="tool-card__name"
                            href={tool.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {tool.name}
                            {tool.badge && <span class="tool-card__badge">{tool.badge}</span>}
                          </a>
                          <p class="tool-card__desc">{tool.desc}</p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ol>

    <p class="q-foot">
      <span>想一口气看全部？</span>
      <a href={wikiIndexHref()}>浏览词条库（{entries.length} 个词条）→</a>
    </p>
  </main>
</Base>
