---
import Base from '../layouts/Base.astro';
import {
  getPublishedGuides,
  faqItemsForGuides,
  guideHref,
  withBase,
} from '../lib/guides';
import { WORKFLOW } from '../lib/workflow';

const guides = await getPublishedGuides();
const steps = WORKFLOW.map((step) => {
  const faqs = faqItemsForGuides(guides, step.guideIds, step.faqPicks);
  const readings = step.guideIds
    .map((id) => guides.find((g) => g.id === id))
    .filter((g): g is NonNullable<typeof g> => Boolean(g));
  return { ...step, faqs, readings };
});
const allHref = withBase('/guides/');
---

<Base
  title="GEO 指南"
  description="做 GEO，就这 6 步：建立认知、摸清现状、配好地基、改造内容、衡量效果、持续迭代。每一步列出你会遇到的问题，点开即看答案，并附建议做法与可用工具。"
>
  <main id="main" class="page page--home">
    <section class="hero">
      <p class="kicker">生成式引擎优化 · GEO</p>
      <h1>做 GEO，就这 {WORKFLOW.length} 步</h1>
      <p class="hero__lead">
        每一步：你会遇到什么问题、怎么解决、用什么工具。点开即看，不用翻文章。
      </p>
    </section>

    <ol class="flow">
      {
        steps.map((step, i) => (
          <li class="flow-step">
            <details class="flow-step__panel">
              <summary class="flow-step__head">
                <span class="flow-step__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flow-step__titles">
                  <strong class="flow-step__title">{step.title}</strong>
                  <span class="flow-step__goal">{step.goal}</span>
                </span>
                <span class="flow-step__meta">
                  {step.faqs.length > 0 && <span>{step.faqs.length} 个问题</span>}
                  {step.tools.length > 0 && <span>{step.tools.length} 个工具</span>}
                  <svg
                    class="flow-step__chevron"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="flow-step__body">
                <p class="flow-step__when">你在这一步：{step.when}</p>

                {step.faqs.length > 0 && (
                  <section class="flow-sec" aria-label="这一步的问题与解答">
                    <h2>你会遇到的问题</h2>
                    <ul class="q-list">
                      {step.faqs.map((item) => (
                        <li class="q-item">
                          <details class="q-a">
                            <summary class="q-a__q">
                              <span class="q-a__qmark" aria-hidden="true">Q</span>
                              <span class="q-a__text">{item.question}</span>
                              <svg
                                class="q-a__chevron"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                aria-hidden="true"
                              >
                                <path
                                  d="M9 6l6 6-6 6"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </summary>
                            <div class="q-a__body">
                              <p class="q-a__answer">{item.answer}</p>
                              <a class="q-a__more" href={item.href}>
                                在《{item.guideTitle}》查看完整解答 →
                              </a>
                            </div>
                          </details>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {step.tools.length > 0 && (
                  <section class="flow-sec" aria-label="这一步可用的工具">
                    <h2>这一步的工具</h2>
                    <ul class="tool-list">
                      {step.tools.map((tool) => (
                        <li class="tool-card">
                          <a class="tool-card__name" href={tool.url} target="_blank" rel="noopener noreferrer">
                            {tool.name}
                            {tool.badge && <span class="tool-card__badge">{tool.badge}</span>}
                          </a>
                          <p class="tool-card__desc">{tool.desc}</p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}

                {step.readings.length > 0 && (
                  <section class="flow-sec" aria-label="建议阅读">
                    <h2>建议阅读</h2>
                    <p class="flow-guides">
                      {step.readings.map((g) => (
                        <a class="guide-chip" href={guideHref(g.id)}>
                          {g.data.title}
                        </a>
                      ))}
                    </p>
                  </section>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ol>

    <p class="q-foot">
      <span>想按主题系统学一遍？</span>
      <a href={allHref}>浏览全部 {guides.length} 篇文章 →</a>
    </p>
  </main>
</Base>
