---
import Base from '../layouts/Base.astro';
import { getWikiEntries, groupByStep, entryHref, relatedEntries, wikiIndexHref } from '../lib/wiki';
import { WORKFLOW } from '../lib/workflow';
import { render } from 'astro:content';

const entries = await getWikiEntries();
const groups = groupByStep(entries);

// 构建期渲染全部词条正文，作为阅读器的隐藏面板
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const step = WORKFLOW.find((s) => s.id === entry.data.step);
    const stepIndex = step ? WORKFLOW.findIndex((s) => s.id === step.id) + 1 : 0;
    const related = relatedEntries(entries, entry.data.related ?? []);
    const tools = entry.data.tools ?? [];
    return { entry, Content, step, stepIndex, related, tools };
  })
);
---

<Base
  title="GEO 指南"
  description={`GEO 知识库：${entries.length} 个词条，一问一答案。左侧按做 GEO 的流程分组，点哪看哪，不用跳页。`}
>
  <main id="main" class="page page--reader">
    <div class="reader">
      <!-- 左栏：按流程分组的折叠目录（顶栏 ⌘K / Ctrl+K 可全库搜索） -->
      <nav class="rd-side" aria-label="词条目录">
        <div class="rd-side__bar">
          <p class="rd-side__count">
            {entries.length} 个词条 · {groups.length} 步流程<br />
            搜索请用顶栏 <kbd>Ctrl K</kbd>
          </p>
        </div>
        <div class="rd-side__scroll" data-rd-tree>
          {
            groups.map(({ step, entries: stepEntries }, i) => (
              <details class="rd-group" data-rd-group data-step={step.id}>
                <summary class="rd-group__title" title={step.goal}>
                  <span class="rd-group__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="rd-group__name">{step.title}</span>
                  <span class="rd-group__count">{stepEntries.length}</span>
                  <svg
                    class="rd-group__chevron"
                    width="10"
                    height="10"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M9 6l6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <ul class="rd-group__list">
                  {stepEntries.map((entry) => (
                    <li>
                      <a class="rd-link" href={entryHref(entry.id)} data-slug={entry.id}>
                        {entry.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </nav>

      <!-- 右栏：即点即显示的答案面板 -->
      <div class="rd-main" data-rd-main>
        <noscript>
          <p class="rd-noscript">
            阅读器需要 JavaScript。<a href={wikiIndexHref()}>直接浏览词条库（每问一页）</a>。
          </p>
        </noscript>

        {
          rendered.map(({ entry, Content, step, stepIndex, related, tools }) => (
            <article class="rd-pane" id={`pane-${entry.id}`} data-slug={entry.id} hidden>
              <header class="rd-pane__header">
                <p class="kicker">
                  {step ? `${step.title} · 第 ${stepIndex} 步` : '词条'}
                </p>
                <h1>{entry.data.title}</h1>
                <section class="entry-answer" aria-label="一句话答案">
                  <p class="entry-answer__label">一句话答案</p>
                  <p class="entry-answer__text">{entry.data.answer}</p>
                </section>
              </header>

              <div class="prose rd-pane__body" data-geo-content>
                <Content />
              </div>

              {tools.length > 0 && (
                <section class="flow-sec entry-tools" aria-label="顺手可用的工具">
                  <h2>顺手可用的工具</h2>
                  <ul class="tool-list">
                    {tools.map((tool) => (
                      <li class="tool-card">
                        <a class="tool-card__name" href={tool.url} target="_blank" rel="noopener noreferrer">
                          {tool.name}
                          {tool.badge && <span class="tool-card__badge">{tool.badge}</span>}
                        </a>
                        {tool.desc && <p class="tool-card__desc">{tool.desc}</p>}
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {related.length > 0 && (
                <section class="related" aria-label="参见">
                  <h2>参见</h2>
                  <ul>
                    {related.map((item) => (
                      <li>
                        <a href={item.href}>{item.title}</a>
                        <p class="related__hint">{item.answer}</p>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              <p class="rd-pane__canonical">
                <a href={entryHref(entry.id)} target="_blank" rel="noopener">独立页打开（利于分享/被 AI 引用）↗</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- 窄屏：浮动目录按钮 -->
    <button class="rd-fab" type="button" data-rd-fab hidden>☰ 目录</button>
  </main>
</Base>

<script>
  function initReader() {
    const main = document.querySelector<HTMLElement>('[data-rd-main]');
    const tree = document.querySelector<HTMLElement>('[data-rd-tree]');
    const side = document.querySelector<HTMLElement>('.rd-side');
    const fab = document.querySelector<HTMLButtonElement>('[data-rd-fab]');
    if (!main || !tree) return;

    const panes = Array.from(main.querySelectorAll<HTMLElement>('.rd-pane'));
    const slugs = panes.map((p) => p.dataset.slug ?? '');
    const groups = Array.from(tree.querySelectorAll<HTMLDetailsElement>('[data-rd-group]'));

    function wrapTables(root: ParentNode) {
      root.querySelectorAll('table').forEach((table) => {
        const parent = table.parentElement;
        if (!parent || parent.classList.contains('geo-table-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'geo-table-wrap';
        parent.insertBefore(wrap, table);
        wrap.appendChild(table);
      });
    }

    function setActive(slug: string) {
      document.querySelectorAll('.rd-link').forEach((a) => {
        a.classList.toggle('is-active', (a as HTMLElement).dataset.slug === slug);
      });
      // 只展开当前词条所在的组，其余保持折叠
      groups.forEach((g) => {
        const contains = g.querySelector(`.rd-link[data-slug="${slug}"]`) !== null;
        g.open = contains;
      });
      if (side) side.classList.remove('open');
      if (fab) fab.hidden = window.innerWidth > 920;
    }

    function open(slug: string, updateHash = true) {
      if (!slugs.includes(slug)) return false;
      panes.forEach((p) => {
        p.hidden = p.dataset.slug !== slug;
      });
      if (updateHash) history.replaceState(null, '', `#${slug}`);
      setActive(slug);
      wrapTables(main);
      window.scrollTo({ top: 0 });
      const activeLink = document.querySelector(`.rd-link[data-slug="${slug}"]`);
      activeLink?.scrollIntoView({ block: 'nearest' });
      return true;
    }

    // 拦截目录点击：就地切换，不跳页
    tree.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest('a[data-slug]');
      if (!anchor) return;
      e.preventDefault();
      open(anchor.dataset.slug ?? '');
    });

    // 拦截面板内互链（正文/参见里的词条链接）与移动端顶栏当前题
    main.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest('a');
      if (!anchor) return;
      const slug = anchor.dataset.slug ?? resolveSlug(anchor);
      if (slug) {
        e.preventDefault();
        open(slug);
      }
    });

    // 把解析出的同站词条链接打上 data-slug，便于拦截
    function resolveSlug(anchor: HTMLAnchorElement): string | null {
      if (anchor.target === '_blank') return null;
      let url: URL;
      try {
        url = new URL(anchor.getAttribute('href') ?? '', location.href);
      } catch {
        return null;
      }
      if (url.origin !== location.origin && url.origin !== 'null') return null;
      if (url.hash && !url.pathname.endsWith('.html') && url.pathname === location.pathname) return null;
      const segs = url.pathname.replace(/\/+$/, '').split('/');
      for (let i = segs.length - 1; i >= 0; i--) {
        if (slugs.includes(segs[i])) return segs[i];
      }
      return null;
    }

    // 窄屏抽屉
    if (fab) {
      fab.hidden = window.innerWidth <= 920 ? false : true;
      fab.addEventListener('click', () => side?.classList.toggle('open'));
      side?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a[data-slug]')) side.classList.remove('open');
      });
    }

    // 深链：#slug 直达词条
    const initial = decodeURIComponent(location.hash.replace('#', ''));
    if (!open(initial)) open(slugs[0]);
    window.addEventListener('hashchange', () => {
      const slug = decodeURIComponent(location.hash.replace('#', ''));
      if (slug) open(slug, false);
    });
  }

  initReader();
</script>
