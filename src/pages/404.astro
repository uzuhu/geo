---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/guides';

const home = withBase('/');
const guides = withBase('/guides/');
---

<Base title="页面不存在" description="没有找到这个页面，试试搜索或回到全部文章。">
  <main id="main" class="page page--list">
    <header class="list-hero">
      <p class="kicker">404</p>
      <h1>没有这篇文章</h1>
      <p>地址可能写错了。用搜索找问题，或回到文章列表。</p>
      <div class="not-found-actions">
        <button class="hero-search hero-search--compact" type="button" data-open-search>
          <span>搜索文章或问题</span>
        </button>
        <p>
          <a href={home}>回首页</a>
          ·
          <a href={guides}>全部文章</a>
        </p>
      </div>
    </header>
  </main>
</Base>
