---
import Base from '../layouts/Base.astro';
import { withBase, wikiIndexHref } from '../lib/wiki';

const home = withBase('/');
const wiki = wikiIndexHref();
---

<Base title="页面不存在" description="没有找到这个词条，试试搜索或回到词条库。">
  <main id="main" class="page page--list">
    <header class="list-hero">
      <p class="kicker">404</p>
      <h1>没有这个词条</h1>
      <p>地址可能写错了。用搜索找问题，或回到词条库。</p>
      <div class="not-found-actions">
        <button class="hero-search hero-search--compact" type="button" data-open-search>
          <span>搜索问题</span>
        </button>
        <p>
          <a href={home}>回首页</a>
          ·
          <a href={wiki}>词条库</a>
        </p>
      </div>
    </header>
  </main>
</Base>
