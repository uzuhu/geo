---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getPublishedGuides, toCard, topicHref, withBase } from '../../lib/guides';
import { TOPICS } from '../../lib/topics';

const guides = await getPublishedGuides();
const cards = guides.map(toCard);
const allHref = withBase('/guides/');
---

<Base title="全部文章" description="浏览全部 GEO 指南，按主题筛选，或直接搜索问题和要点。">
  <main id="main" class="page page--list">
    <header class="list-hero">
      <p class="kicker">文章库</p>
      <h1>全部文章</h1>
      <p>用主题缩小范围，或打开搜索直接找问题和做法。</p>
      <button class="hero-search hero-search--compact" type="button" data-open-search>
        <span>搜索标题、要点或常见问题</span>
        <kbd>Ctrl K</kbd>
      </button>
    </header>

    <nav class="topic-pills" aria-label="主题">
      <a class="is-active" href={allHref}>全部</a>
      {
        TOPICS.map((topic) => (
          <a href={topicHref(topic.id)}>{topic.label}</a>
        ))
      }
    </nav>

    <div class="guide-grid">
      {
        cards.map((card) => (
          <GuideCard
            href={card.href}
            title={card.title}
            description={card.description}
            kicker={card.kicker}
          />
        ))
      }
    </div>
  </main>
</Base>
