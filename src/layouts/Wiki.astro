---
import Base from './Base.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import GeoSeo from '../components/GeoSeo.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
  entryHref,
  entryStep,
  getWikiEntries,
  relatedEntries,
  wikiIndexHref,
  withBase,
  type WikiEntry,
} from '../lib/wiki';
import { WORKFLOW } from '../lib/workflow';
import { render } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: WikiEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const step = entryStep(entry);
const stepIndex = step ? WORKFLOW.findIndex((s) => s.id === step.id) + 1 : 0;
const allEntries = await getWikiEntries();
const related = relatedEntries(allEntries, data.related ?? []);
const tools = data.tools ?? [];
const site = Astro.site ?? new URL('https://uzuhu.github.io');
const canonicalURL = new URL(Astro.url.pathname, site).href;
const home = withBase('/');

const breadcrumbs = [
  { name: 'GEO 指南', url: new URL(home, site).href },
  { name: '词条库', url: new URL(wikiIndexHref(), site).href },
  { name: data.title, url: canonicalURL },
];
---

<Base title={data.title} description={data.answer}>
  <Fragment slot="head">
    <GeoSeo
      title={data.title}
      description={data.answer}
      url={canonicalURL}
      publishDate={data.publishDate ? data.publishDate.toISOString() : undefined}
      updatedDate={data.updatedDate ? data.updatedDate.toISOString() : undefined}
      authorName={data.author}
      publisherName="uzuhu"
      faq={[{ question: data.title, answer: data.answer }]}
      breadcrumbs={breadcrumbs}
    />
  </Fragment>

  <main id="main" class="page page--article">
    <div class="article-shell">
      <div class="article-main">
        <nav class="crumbs" aria-label="面包屑">
          <a href={home}>首页</a>
          <span aria-hidden="true">/</span>
          <a href={wikiIndexHref()}>词条库</a>
        </nav>

        <header class="article-header">
          <p class="kicker">{step ? `${step.title} · 流程第 ${stepIndex} 步` : '词条'}</p>
          <h1>{data.title}</h1>
          <ArticleMeta author={data.author} publishDate={data.publishDate} updatedDate={data.updatedDate} />
        </header>

        <section class="entry-answer" aria-label="一句话答案">
          <p class="entry-answer__label">一句话答案</p>
          <p class="entry-answer__text">{data.answer}</p>
        </section>

        <details class="toc-mobile">
          <summary>本篇目录</summary>
          <TableOfContents headings={headings as Heading[]} />
        </details>

        <article class="prose" data-geo-content>
          <Content />
        </article>

        {
          tools.length > 0 && (
            <section class="flow-sec entry-tools" aria-label="顺手可用的工具">
              <h2>顺手可用的工具</h2>
              <ul class="tool-list">
                {tools.map((tool) => (
                  <li class="tool-card">
                    <a class="tool-card__name" href={tool.url} target="_blank" rel="noopener noreferrer">
                      {tool.name}
                      {tool.badge && <span class="tool-card__badge">{tool.badge}</span>}
                    </a>
                    {tool.desc && <p class="tool-card__desc">{tool.desc}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          related.length > 0 && (
            <section class="related" aria-label="参见">
              <h2>参见</h2>
              <ul>
                {related.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                    <p class="related__hint">{item.answer}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="article-aside">
        <TableOfContents headings={headings as Heading[]} />
      </aside>
    </div>
  </main>
</Base>

<script>
  function wrapGeoTables() {
    document.querySelectorAll('[data-geo-content] table').forEach((table) => {
      const parent = table.parentElement;
      if (!parent || parent.classList.contains('geo-table-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'geo-table-wrap';
      parent.insertBefore(wrap, table);
      wrap.appendChild(table);
    });
  }
  wrapGeoTables();
</script>
