---
/**
 * 全站外壳：字体、主题、顶栏检索、页脚。
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { buildSearchIndex, getPublishedGuides, withBase } from '../lib/guides';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = '面向 ChatGPT、Claude、Perplexity 与 Google AI Overviews 的 GEO 实战指南。按问题找文章，持续更新。', canonical } = Astro.props;
const siteName = 'GEO 指南';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const site = Astro.site ?? new URL('https://uzuhu.github.io');
const canonicalURL = canonical ?? new URL(Astro.url.pathname, site).href;
const guides = await getPublishedGuides();
const searchItems = buildSearchIndex(guides);
const homeHref = withBase('/');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteName} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700&family=Noto+Serif+SC:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('geo-theme');
          var theme =
            stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header homeHref={homeHref} />
    <slot />
    <Footer />
    <SearchDialog items={searchItems} />
  </body>
</html>
