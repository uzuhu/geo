---
import { withBase, wikiIndexHref } from '../lib/wiki';

const home = withBase('/');
const wiki = wikiIndexHref();
const github = 'https://github.com/uzuhu/geo';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>
      <a href={home}>GEO 指南</a>
      一问一词条：点开问题，直接看到答案。
    </p>
    <nav aria-label="页脚">
      <a href={wiki}>词条库</a>
      <a href={github}>GitHub</a>
    </nav>
  </div>
</footer>
