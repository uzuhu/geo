---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="本篇目录">
      <p class="toc__title">本篇目录</p>
      <ol>
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
