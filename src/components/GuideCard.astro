---
interface Props {
  href: string;
  title: string;
  description: string;
  kicker: string;
  featured?: boolean;
}

const { href, title, description, kicker, featured = false } = Astro.props;
---

<a class:list={['guide-card', featured && 'guide-card--feature']} href={href}>
  <span class="guide-card__kicker">{kicker}</span>
  <h3 class="guide-card__title">{title}</h3>
  <p class="guide-card__desc">{description}</p>
  <span class="guide-card__more">阅读</span>
</a>
