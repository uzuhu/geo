---
interface SearchItem {
  type: 'entry';
  href: string;
  title: string;
  hint: string;
  topic: string;
  haystack: string;
}

interface Props {
  items: SearchItem[];
}

const { items } = Astro.props;
const payload = JSON.stringify(items).replace(/</g, '\\u003c');
---

<dialog class="search-dialog" data-search-dialog>
  <form class="search-dialog__panel" method="dialog">
    <label class="search-dialog__label" for="geo-search-input">搜索问题</label>
    <input
      id="geo-search-input"
      class="search-dialog__input"
      type="search"
      placeholder="例如：关键词堆砌、Prompt Panel、robots.txt"
      autocomplete="off"
      data-search-input
    />
    <p class="search-dialog__hint">词条标题与一句话答案都会被搜到。Esc 关闭。</p>
    <div class="search-dialog__results" data-search-results></div>
    <button class="search-dialog__close" value="cancel" type="submit">关闭</button>
  </form>
</dialog>

<script id="geo-search-index" type="application/json" set:html={payload} />

<script>
  type SearchItem = {
    type: 'entry';
    href: string;
    title: string;
    hint: string;
    topic: string;
    haystack: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const raw = document.getElementById('geo-search-index')?.textContent ?? '[]';
  const items = JSON.parse(raw) as SearchItem[];

  function openSearch() {
    dialog?.showModal();
    input?.focus();
    input?.select();
    render(input?.value ?? '');
  }

  function closeSearch() {
    dialog?.close();
  }

  function render(query: string) {
    if (!results) return;
    const q = query.trim().toLowerCase();
    const matched = q
      ? items.filter((item) => item.haystack.includes(q) || item.title.toLowerCase().includes(q)).slice(0, 12)
      : items.slice(0, 6);

    if (matched.length === 0) {
      results.innerHTML = `<p class="search-empty">没有找到「${escapeHtml(query)}」。试试更短的词，或浏览词条库。</p>`;
      return;
    }

    results.innerHTML = matched
      .map((item) => {
        const kind = '词条';
        return `<a class="search-hit" href="${item.href}">
          <span class="search-hit__kind">${kind} · ${escapeHtml(item.topic)}</span>
          <span class="search-hit__title">${escapeHtml(item.title)}</span>
          <span class="search-hit__hint">${escapeHtml(item.hint)}</span>
        </a>`;
      })
      .join('');
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  document.querySelectorAll('[data-open-search]').forEach((button) => {
    button.addEventListener('click', openSearch);
  });

  input?.addEventListener('input', () => render(input.value));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeSearch();
  });

  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog?.open) closeSearch();
      else openSearch();
    }
  });
</script>
