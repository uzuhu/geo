---
import { withBase } from '../lib/guides';
import { scenarioHref } from '../lib/scenarios';

interface Props {
  homeHref: string;
}

const { homeHref } = Astro.props;
const guidesHref = withBase('/guides/');
const scenariosHref = scenarioHref('cite').replace(/\/cite\/$/, '/');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={homeHref}>
      <span class="brand__mark" aria-hidden="true">G</span>
      <span class="brand__text">
        <span class="brand__name">GEO 指南</span>
        <span class="brand__tag">按任务找做法</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a href={scenariosHref}>场景</a>
      <a href={guidesHref}>全部文章</a>
    </nav>

    <div class="site-header__actions">
      <button class="search-trigger" type="button" data-open-search>
        <span class="search-trigger__label">搜索文章或问题</span>
        <kbd>K</kbd>
      </button>
      <button class="icon-btn search-trigger-icon" type="button" data-open-search aria-label="搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深浅色">
        <span data-theme-icon>夜</span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector('[data-theme-toggle]');
  const icon = document.querySelector('[data-theme-icon]');

  function currentTheme() {
    return root.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function renderIcon() {
    if (icon) icon.textContent = currentTheme() === 'dark' ? '昼' : '夜';
  }

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('geo-theme', next);
    renderIcon();
  });

  renderIcon();
</script>
