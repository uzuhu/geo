---
/**
 * KeyTakeaways.astro
 * “核心要点”高亮卡片组件，用于文章头部直观呈现 GEO 友好的内容摘要。
 * 内容来自 frontmatter 的 takeaways 字段（string[]）。
 */
interface Props {
  items: string[];
  title?: string;
}

const { items, title = '核心要点' } = Astro.props;
---

{
  items && items.length > 0 && (
    <section class="geo-takeaways" aria-label={title}>
      <p class="geo-takeaways__title">{title}</p>
      <ul>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  )
}
